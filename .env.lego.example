# BrickPoint (LEGO edition). A second Discord application + a second App Runner service, same image.
GAME=lego
# Brickset API key (free): https://brickset.com/tools/webservices/requestkey . Without it a bundled pool of ~40 sets is used.
BRICKSET_API_KEY=
# Day rolls over at midnight in this timezone
GAME_TZ=America/Los_Angeles

# The second Discord application's credentials
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=

# AWS deploy target used by set-env.mjs
AWS_PROFILE=
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=
APPRUNNER_SERVICE_NAME=brickpoint
APPRUNNER_SERVICE_ID=
