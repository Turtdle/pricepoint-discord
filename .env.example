# From https://discord.com/developers/applications -> your app -> OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Bot -> Reset Token. Lets the app post the results card into the channel. Optional; without it nothing is posted.
DISCORD_BOT_TOKEN=


PORT=3001

# pricepoint (default) | local
PUZZLE_SOURCE=pricepoint

# 1 = let a plain browser (outside Discord) join without a Discord token, for local testing
ALLOW_ANON=0
