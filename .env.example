# From https://discord.com/developers/applications -> your app -> OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Bot -> Reset Token. Lets the app post the results card into the channel. Optional; without it nothing is posted.
DISCORD_BOT_TOKEN=
# General Information -> Public Key. Verifies Discord's calls to /api/interactions (used to launch without posting an invite).
DISCORD_PUBLIC_KEY=


PORT=3001

# pricepoint (default) | lego  — see .env.lego.example for the LEGO edition
GAME=pricepoint

# pricepoint (default) | local
PUZZLE_SOURCE=pricepoint

# 1 = let a plain browser (outside Discord) join without a Discord token, for local testing
ALLOW_ANON=0

# AWS deploy target used by deploy.sh and set-env.mjs
AWS_PROFILE=
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=
APPRUNNER_SERVICE_ID=

# Durable scoreboard (App Runner disk is wiped on every deploy). Key defaults to <GAME>/results.json.
RESULTS_S3_BUCKET=
